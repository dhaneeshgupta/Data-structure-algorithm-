{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile and Run",
            "type": "process",
            "command": "/bin/bash",
            "args": [
                "-c",
                "/usr/bin/clang++ -std=c++17 \"${file}\" -o \"${fileDirname}/${fileBasenameNoExtension}\" && \"${fileDirname}/${fileBasenameNoExtension}\" < \"${fileDirname}/input.txt\" > \"${fileDirname}/output.txt\""
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}